{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Wireless Monitor",
  "version": "0.1.0",
  "identifier": "com.wirelessmonitor.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wireless Monitor",
        "width": 960,
        "height": 640,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../drivers/windows/**/*"
    ],
    "copyright": "Copyright © 2026 Wireless Monitor Project",
    "category": "Utility",
    "license": "MIT",
    "shortDescription": "Cross-platform bidirectional wireless virtual monitor",
    "longDescription": "High-performance low-latency wireless virtual secondary display solution with bidirectional streaming between Windows and Linux.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "en-US"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0",
          "libdbus-1-3",
          "libxdo3",
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37"
        ],
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
